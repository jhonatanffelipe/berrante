{
  "name": "berrante",
  "productName": "Berrante",
  "version": "0.6.1",
  "description": "Um toque e a boiada vem junto: gerenciador local de projetos e serviços.",
  "author": "Jhonatan Felipe",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "yarn typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "dist": "yarn build && electron-builder --mac && node scripts/clean-unpacked.mjs",
    "dist:dir": "yarn build && electron-builder --mac --arm64 --dir",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon": "node scripts/make-icon.mjs",
    "postinstall": "node node_modules/electron/install.js && node scripts/dev-app-name.mjs && electron-builder install-app-deps",
    "predev": "node scripts/dev-app-name.mjs"
  },
  "dependencies": {
    "dotenv": "18.0.10",
    "otplib": "13.6.0",
    "qrcode": "1.5.4",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@types/node": "24.19.4",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.32",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "autoprefixer": "10.7.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.33",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "homepage": "https://github.com/jhonatanffelipe/berrante"
}
