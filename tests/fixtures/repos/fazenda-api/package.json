{
  "name": "fazenda-api",
  "version": "0.1.0",
  "private": true,
  "description": "API de exemplo do Fazenda (projeto fictício usado nos testes do Berrante)",
  "author": "Jhonatan Felipe",
  "license": "UNLICENSED",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "ts-node-dev --inspect --respawn --transpile-only -r tsconfig-paths/register src/shared/infra/http/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/shared/infra/http/server.js",
    "worker:start": "ts-node-dev --transpile-only -r tsconfig-paths/register src/shared/infra/queue/worker.ts",
    "migration:create": "sh -c 'typeorm-ts-node-commonjs migration:create src/shared/infra/typeorm/migrations/$1' --",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/shared/infra/typeorm/cli/migrations.dataSource.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/shared/infra/typeorm/cli/migrations.dataSource.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/shared/infra/typeorm/cli/migrations.dataSource.ts",
    "migration:run:prod": "typeorm migration:run -d dist/shared/infra/typeorm/cli/migrations.dataSource.js",
    "seed:run": "typeorm-ts-node-commonjs migration:run -d src/shared/infra/typeorm/cli/seeds.dataSource.ts",
    "seed:revert": "typeorm-ts-node-commonjs migration:revert -d src/shared/infra/typeorm/cli/seeds.dataSource.ts",
    "seed:run:prod": "typeorm migration:run -d dist/shared/infra/typeorm/cli/seeds.dataSource.js",
    "seed:dev:run": "typeorm-ts-node-commonjs migration:run -d src/shared/infra/typeorm/cli/devSeeds.dataSource.ts",
    "seed:dev:revert": "typeorm-ts-node-commonjs migration:revert -d src/shared/infra/typeorm/cli/devSeeds.dataSource.ts",
    "audit:high": "sh -c 'yarn audit --groups dependencies --level high; status=$?; [ $((status & 24)) -eq 0 ]'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest -c jest.integration.config.js --runInBand",
    "job:purge-versions": "ts-node --transpile-only -r tsconfig-paths/register src/shared/infra/jobs/scripts/purgeOldVersions.ts"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "~10.4.1",
    "pg": "^8.16.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.27",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.3.0",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0"
  }
}
